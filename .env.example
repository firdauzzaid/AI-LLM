# ========================================
# DATABASE (PostgreSQL)
# ========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lead_workflow
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Connection URL untuk Prisma (akan dipakai di tahap berikutnya)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lead_workflow?schema=public"

# ========================================
# REDIS
# ========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ========================================
# APP
# ========================================
NODE_ENV=development
API_PORT=3000

# ========================================
# AUTH
# ========================================
JWT_SECRET=change-me-to-random-string-min-32-chars
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# ========================================
# AI PROVIDER (akan diisi di tahap 8)
# ========================================
AI_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=